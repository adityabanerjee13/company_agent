# Slack (Socket Mode)
SLACK_APP_TOKEN=xapp-...
SLACK_BOT_TOKEN=xoxb-...

# LLM for the orchestrator and the GitHub agent
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=x-ai/grok-4.6

# GitHub token: reads PRs, clones/pushes for coding jobs, opens PRs
GITHUB_TOKEN=github_pat_...

# Coding jobs
SANDBOX_IMAGE=coding-agent-sandbox
SANDBOX_TIMEOUT_SECONDS=2700
SUBSCRIPTIONS_FILE=subscriptions.json

DB_PATH=agent.db

# Slack catch-up sync (optional; defaults shown)
# SLACK_USER_TOKEN=xoxp-...   # reads every conversation that user can see, instead of only the bot's
# SLACK_SYNC_INTERVAL_SECONDS=300
# SLACK_SYNC_LOOKBACK_HOURS=24
# SLACK_PRUNE_DAYS=30
# SLACK_PRUNE_INTERVAL_HOURS=24
